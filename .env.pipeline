# Staging Environment Configuration
STAGING_ENV=staging
STAGING_LOG_LEVEL=info
STAGING_METRICS_ENABLED=true
STAGING_BACKUP_RETENTION_DAYS=30
STAGING_HEALTH_CHECK_INTERVAL=30
STAGING_HEALTH_CHECK_TIMEOUT=10
STAGING_HEALTH_CHECK_RETRIES=3
STAGING_DEPLOYMENT_TIMEOUT=300

# Production Environment Configuration
PRODUCTION_ENV=production
PRODUCTION_LOG_LEVEL=info
PRODUCTION_METRICS_ENABLED=true
PRODUCTION_BACKUP_RETENTION_DAYS=90
PRODUCTION_HEALTH_CHECK_INTERVAL=30
PRODUCTION_HEALTH_CHECK_TIMEOUT=10
PRODUCTION_HEALTH_CHECK_RETRIES=5
PRODUCTION_DEPLOYMENT_TIMEOUT=600

# Docker Registry
REGISTRY=ghcr.io
REGISTRY_PULL_POLICY=always

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_COMPRESSION=gzip
BACKUP_RETENTION_DAYS=30

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
ALERT_CHANNEL=slack
